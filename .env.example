# Copy the names below into Vercel (Project > Settings > Environment Variables).
# Do NOT put real values in this file or commit them to GitHub.
#
# These two come from a free Upstash Redis database
# (add it from the Vercel Marketplace and Vercel fills them in for you).
# Vercel's Upstash integration may name them KV_REST_API_URL and KV_REST_API_TOKEN.
# Both naming styles work.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Optional: how many responses must exist before results are shown publicly.
# Default is 10. (Local development uses 3 so you can try it quickly.)
MIN_RESPONSES=10
