# Copy the names below into Vercel (Project > Settings > Environment Variables).
# Do NOT put real values in this file or commit them to GitHub.
#
# These two come from a free Upstash Redis database
# (add it from the Vercel Marketplace and Vercel fills them in for you).
# Vercel's Upstash integration may name them KV_REST_API_URL and KV_REST_API_TOKEN.
# Both naming styles work.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Optional: how many responses must exist before results are shown publicly.
# Default is 10. (Local development uses 3 so you can try it quickly.)
MIN_RESPONSES=10

# Repeat-submission protection (REQUIRED for a public launch).
# A long random secret (at least 16 characters). It scrambles each visitor's network
# address into an unreadable code, so the real address is never stored.
# Make one with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Without it the limit is switched OFF (and a warning is written to the logs).
# Changing it later is harmless: everyone's counters simply start fresh.
RATE_LIMIT_SALT=

# Optional: answers allowed per network address per 24 hours (default 5, range 1 to 100).
# Raise it if you expect many people on one network, such as a school.
RATE_LIMIT_MAX=5

# Preview isolation (set ONLY for the Preview environment in Vercel, never for Production).
# A short name for this preview's private corner of the database. Lowercase letters, digits
# and single hyphens, 3 to 40 characters, for example: rate-limit-test
# Preview data is stored under  boba-preview:<name>:v1:*  and can never mix with live data.
# A Preview without a valid value has storage switched OFF (it never falls back to live data).
# Production ignores this setting completely.
PREVIEW_NAMESPACE=
